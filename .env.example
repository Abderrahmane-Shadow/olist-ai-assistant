# ==============================================================================
# Olist AI Assistant - Frontend Environment Variables Template (Next.js)
# Copy this file to .env.local (or .env) and populate with your credentials.
# Note: Backend secrets (SUPABASE_JWT_SECRET, GEMINI_API_KEY, DB credentials)
# must NEVER be placed here; they belong exclusively in backend/.env.
# ==============================================================================

# Fast-API Backend Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase Project Credentials (safe for client-side browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Backward-compatibility fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: Next.js Local Development Port
PORT=3000
