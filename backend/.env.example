# ==============================================================================
# Olist AI Assistant Backend - Environment Variables Template
# Copy this file to backend/.env and populate with your credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://olist-ai-assistant.vercel.app

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olist_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Dedicated Read-Only User for Secure Text-to-SQL Execution
DB_READONLY_USER=olist_readonly
DB_READONLY_PASSWORD=olist_readonly_2026

# Hosted PostgreSQL Connection Strings (Supabase / Neon / Render)
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# DATABASE_RO_URL=postgresql+psycopg://olist_readonly:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Supabase Auth Configuration
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
REQUIRE_AUTH=false
MAX_DAILY_QUESTIONS_PER_USER=15
MAX_CONCURRENT_PER_USER=2

# Google Gemini API Configuration (Multi-Model Fallback Cascade)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash
